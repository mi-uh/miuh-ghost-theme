{{!< default}}

{{!--
    Lists the latest posts grouped by primary tag.
    Each tag needs its own posts query, so only tags that have posts are
    rendered and the number of posts per tag is limited explicitly.
    The tag heading links to the full tag archive.
--}}

<main class="site-main outer">
    <div class="inner">

        {{#post}}
            <header class="article-header">
                <h1 class="article-title">{{title}}</h1>
            </header>
        {{/post}}

        {{#get "tags" limit="100" include="count.posts" order="name asc"}}
            {{#foreach tags}}
                {{#if count.posts}}

                    <section class="blog-category">
                        <h2>
                            <a href="{{url}}">{{name}}</a>
                        </h2>

                        <div class="post-feed">
                            {{#get "posts"
                                filter="primary_tag:{{slug}}"
                                include="authors,tags"
                                order="published_at desc"
                                limit="15"}}

                                {{#foreach posts}}
                                    {{> "post-card"}}
                                {{/foreach}}

                            {{/get}}
                        </div>
                    </section>

                {{/if}}
            {{/foreach}}
        {{/get}}

    </div>
</main>
